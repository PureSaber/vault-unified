# Bitwarden CLI (optional — for import/sync)
# BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BW_PASSWORD=your_bitwarden_master_password
# BW_SERVER=https://vault.bitwarden.com

# Proton Pass CLI (optional — for import/sync)
# PROTON_PASS_PERSONAL_ACCESS_TOKEN=pst_xxxxxxxxxxxxxxxxxxxxxxxx
# PROTON_PASS_SHARE_ID=your_vault_share_id
# PROTON_PASS_VAULT_NAME=Personal

# API server (desktop app sidecar)
# VAULT_API_HOST=127.0.0.1
# VAULT_API_PORT=8765
