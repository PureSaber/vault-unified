{
  "manifest_version": 3,
  "name": "Vault Unified Personal Fill",
  "description": "User-clicked fill from an unlocked local Vault Unified desktop app.",
  "version": "1.2.0",
  "action": {
    "default_title": "Vault Unified Fill",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}
