{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault Unified",
  "version": "1.4.0",
  "identifier": "com.puresaber.vault-unified",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vault Unified",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/vault-api-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "upgradeCode": "e8854b25-a560-5856-9eb1-2e5c3174ddbe",
        "fragmentPaths": [
          "windows/browser-cleanup.wxs"
        ],
        "componentRefs": [
          "BrowserCleanupMarker"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNTgwN0U2OTUyMEM3OUQKUldTZHh5Q1Y1Z2RZWDJ1MTZ6a1NNeWV2aTdUQXZncWgzZDZkN2QvK1g1WnZhOW5yZHJ3WG5nSXQK",
      "endpoints": [
        "https://github.com/PureSaber/vault-unified/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
